# =============================================================================
# Backend environment template. Copy to .env and replace every placeholder.
#   cp .env.example .env
#   npm run keys:generate      # then paste JWT_PRIVATE_KEY / JWT_PUBLIC_KEY below
#   npm run kong:render
# .env is git-ignored. Never commit real credentials.
# For production, source these from a secret manager instead of a file.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true
SWAGGER_ENABLED=true
BODY_LIMIT=512kb
IMAGE_TAG=local
RUN_MIGRATIONS=true
RUN_SEED=true

# Comma-separated browser origins allowed by Kong and by the services.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ---- PostgreSQL --------------------------------------------------------------
# The owner role only bootstraps schemas. Each service authenticates as its own
# least-privilege role and can reach exactly one schema.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecom_owner
POSTGRES_PASSWORD=replace-with-a-long-random-value
AUTH_DB_PASSWORD=replace-with-a-long-random-value
ADMIN_DB_PASSWORD=replace-with-a-long-random-value
PUBLIC_DB_PASSWORD=replace-with-a-long-random-value

# ---- Redis -------------------------------------------------------------------
REDIS_PASSWORD=replace-with-a-long-random-value
REDIS_KEY_PREFIX=ecom
CACHE_ENABLED=true
CATALOG_CACHE_TTL_SECONDS=120
REDISINSIGHT_PORT=5540

# ---- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=ecom
RABBITMQ_PASSWORD=replace-with-a-long-random-value
RABBITMQ_VHOST=/
RABBITMQ_ENABLED=true
RABBITMQ_MANAGEMENT_PORT=15672

# ---- JWT (RS256) -------------------------------------------------------------
# Produced by `npm run keys:generate`. Base64 or literal PEM are both accepted.
# JWT_PRIVATE_KEY is consumed by the auth service only; it must never be shared.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=ecom-auth
JWT_AUDIENCE=ecom-api
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---- Service-to-service authentication ---------------------------------------
# Guards the /internal endpoints, which Kong also terminates at the edge.
# Generate with: openssl rand -base64 36
INTERNAL_API_KEY=replace-with-at-least-24-characters

# ---- Super admin bootstrap ---------------------------------------------------
# Used once, when no super admin exists. The account is never recreated or
# silently overwritten. Set SUPER_ADMIN_ROTATE_PASSWORD=true for one deliberate
# startup to rotate the password, then set it back to false.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_ROTATE_PASSWORD=false

# ---- Authentication hardening ------------------------------------------------
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ---- Kong --------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_MANAGER_PORT=8002
KONG_LOG_LEVEL=notice
KONG_WORKERS=2
KONG_RATE_LIMIT_PER_MINUTE=300
KONG_AUTH_RATE_LIMIT_PER_MINUTE=20

# ---- Invoicing ---------------------------------------------------------------
INVOICE_COMPANY_NAME="Aurelia Commerce Ltd"
INVOICE_COMPANY_ADDRESS="House 42, Road 11, Banani, Dhaka 1213"
INVOICE_COMPANY_EMAIL=billing@aurelia.example
INVOICE_COMPANY_REGISTRATION="UEN 202400123X"
INVOICE_CURRENCY=BDT
INVOICE_TAX_RATE=0
SHIPPING_FLAT_RATE=120
FREE_SHIPPING_THRESHOLD=5000

# ---- Outbox relay ------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
