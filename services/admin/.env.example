# Local development overrides for the admin service.
SERVICE_NAME=admin-service
PORT=3002
DATABASE_URL=postgresql://admin_service:CHANGE_ME@localhost:5432/ecommerce
# Pool sizing per instance. The service applies its owned schema as the search_path.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
REDIS_URL=redis://:CHANGE_ME@localhost:6379/1
RABBITMQ_URL=amqp://ecom:CHANGE_ME@localhost:5672/
AUTH_SERVICE_URL=http://localhost:3001
INVOICE_STORAGE_DIR=./storage/invoices
