# Local development overrides for the auth service.
# Values not set here fall back to the repository root .env.
SERVICE_NAME=auth-service
PORT=3001
DATABASE_URL=postgresql://auth_service:CHANGE_ME@localhost:5432/ecommerce
# Pool sizing per instance. The service applies its owned schema as the search_path.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
RABBITMQ_URL=amqp://ecom:CHANGE_ME@localhost:5672/
