# Local development overrides for the public (storefront) service.
SERVICE_NAME=public-service
PORT=3003
DATABASE_URL=postgresql://public_service:CHANGE_ME@localhost:5432/ecommerce
# Pool sizing per instance. The service applies its owned schema as the search_path.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
REDIS_URL=redis://:CHANGE_ME@localhost:6379/2
RABBITMQ_URL=amqp://ecom:CHANGE_ME@localhost:5672/
ADMIN_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001
